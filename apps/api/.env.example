# Porta HTTP da API
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URL=mongodb://localhost:27017/barbearia

# JWT (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=troque-por-um-segredo-longo
JWT_REFRESH_SECRET=troque-por-outro-segredo-longo
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Google OAuth (console.cloud.google.com > Credenciais)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Precisa estar cadastrada como "URI de redirecionamento autorizado" no Google
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/redirect

# URL do front (CORS e destino do redirecionamento pós-login)
FRONTEND_URL=http://localhost:3001
